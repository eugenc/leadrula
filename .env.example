# ── Backend (Go API) ──────────────────────────────────────────────
PORT=8080
DATABASE_URL=postgres://crm:crm@localhost:5432/crm?sslmode=disable

# JWT secrets (generate with: openssl rand -base64 48)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Base URL of the deployed frontend (used in invite / reset links)
APP_BASE_URL=http://localhost:5173

# Allowed CORS origins (comma separated)
CORS_ORIGINS=http://localhost:5173

# ── Email (Mailgun SMTP) ──────────────────────────────────────────
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@your-domain.mailgun.org
SMTP_PASS=change-me
SMTP_FROM=no-reply@yourdomain.com

# ── Bootstrap (first publisher admin) ─────────────────────────────
BOOTSTRAP_EMAIL=admin@example.com
BOOTSTRAP_PASSWORD=change-me-please
BOOTSTRAP_NAME=Publisher Admin

# ── Frontend (Vite) ───────────────────────────────────────────────
# Set in frontend/.env — kept here for reference
VITE_API_URL=http://localhost:8080
