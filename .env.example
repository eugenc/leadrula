# ── Backend (Go API) ──────────────────────────────────────────────
PORT=8080
DATABASE_URL=postgres://crm:crm@localhost:5432/crm?sslmode=disable

# JWT secrets (generate with: openssl rand -base64 48)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Base URL of the deployed frontend (used in invite / reset links)
APP_BASE_URL=http://localhost:5173

# Allowed CORS origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ── Email (Mailgun API) ───────────────────────────────────────────


# ── Stripe (billing) ──────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PLATFORM_FEE=0.10
STRIPE_CONNECT_CLIENT_ID=ca_...
# OAuth redirect uses INTEGRATION_OAUTH_REDIRECT_BASE + /publisher/billing/stripe/oauth/callback
# Register webhook in Stripe Dashboard: POST https://<api-host>/webhooks/stripe
# Event: payment_intent.succeeded
# Local dev: stripe listen --forward-to localhost:8080/webhooks/stripe

# ── Object storage (Railway S3 bucket — user avatars) ─────────────
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

# ── Integrations (BYOI outbound delivery) ─────────────────────────
# Generate: openssl rand -hex 32
INTEGRATION_ENC_KEY=
# Backend base URL for OAuth callbacks (must match provider app settings)
INTEGRATION_OAUTH_REDIRECT_BASE=http://localhost:8080
PIPEDRIVE_CLIENT_ID=
PIPEDRIVE_CLIENT_SECRET=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
ZOHO_CRM_CLIENT_ID=
ZOHO_CRM_CLIENT_SECRET=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=

# ── Bootstrap (first publisher admin) ─────────────────────────────
BOOTSTRAP_EMAIL=admin@example.com
BOOTSTRAP_PASSWORD=change-me-please
BOOTSTRAP_NAME=Publisher Admin

# ── Frontend (Vite) ───────────────────────────────────────────────
# Set in frontend/.env — kept here for reference
VITE_API_URL=http://localhost:8080
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
